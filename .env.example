# Required: OpenAI key used for the roast model.
OPENAI_API_KEY=

# Optional: raises the GitHub API rate limit for public repository reads.
GITHUB_TOKEN=

# Optional: LangSmith tracing (enabled when the key is set unless LANGSMITH_TRACING=false).
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=RepoRoasterNew

# Optional: canonical site origin for metadata and social cards.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
