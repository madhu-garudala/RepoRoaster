# Roast model. Set ONE of the two provider keys.
#
# Anthropic (Claude Haiku). When ANTHROPIC_API_KEY is set it is used automatically.
ANTHROPIC_API_KEY=
# Optional: override the Claude model id (default: claude-haiku-5-5).
ANTHROPIC_MODEL=
#
# OpenAI (GPT-5.6 Luna). Used when no Anthropic key is set.
OPENAI_API_KEY=
#
# Optional: force a provider when both keys are present: "anthropic" or "openai".
LLM_PROVIDER=

# Optional: raises the GitHub API rate limit for public repository reads.
GITHUB_TOKEN=

# Optional: LangSmith tracing (enabled when the key is set unless LANGSMITH_TRACING=false).
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=RepoRoasterNew

# Optional: canonical site origin for metadata and social cards.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
